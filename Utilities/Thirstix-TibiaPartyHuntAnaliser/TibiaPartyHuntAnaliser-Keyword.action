      "name": "Hunt analiser",
      "content": "{=rawAnaliser;{message}}\r\n{=analiserLines;{split;{$rawAnaliser};\\n}}\r\n{catch;\r\n    {=header.fromDate;{find;{$analiserLines.0};/(?<=Session data: From )\\d\\d\\d\\d-\\d\\d-\\d\\d(?=, \\d\\d:\\d\\d:\\d\\d to \\d\\d\\d\\d-\\d\\d-\\d\\d, \\d\\d:\\d\\d:\\d\\d)/}}\r\n    {=header.fromHour;{find;{$analiserLines.0};/(?<=Session data: From \\d\\d\\d\\d-\\d\\d-\\d\\d, )\\d\\d:\\d\\d:\\d\\d(?= to \\d\\d\\d\\d-\\d\\d-\\d\\d, \\d\\d:\\d\\d:\\d\\d)/}}\r\n    {=header.toDate;{find;{$analiserLines.0};/(?<=Session data: From \\d\\d\\d\\d-\\d\\d-\\d\\d, \\d\\d:\\d\\d:\\d\\d to )\\d\\d\\d\\d-\\d\\d-\\d\\d(?=, \\d\\d:\\d\\d:\\d\\d)/}}\r\n    {=header.toHour;{find;{$analiserLines.0};/(?<=Session data: From \\d\\d\\d\\d-\\d\\d-\\d\\d, \\d\\d:\\d\\d:\\d\\d to \\d\\d\\d\\d-\\d\\d-\\d\\d, )\\d\\d:\\d\\d:\\d\\d(?=)$/}}\r\n    {if;{and;{$header.fromDate};{$header.fromHour};{$header.toDate};{$header.toHour}};;{throw;}}\r\n    {=avoidPrint;{shift;{$analiserLines}}}\r\n;\r\n    {responder.text;Error in line 1 - Session data}\r\n    {return}\r\n}\r\n\r\n{catch;\r\n    {=header.duration;{find;{replace;{$analiserLines.0};h;};/(?<=Session: )\\d\\d:\\d\\d(?=)$/}}\r\n    {if;{$header.duration};;{throw;}}\r\n    {=avoidPrint;{shift;{$analiserLines}}}\r\n;\r\n    {responder.text;Error in line 2 - Session duration}\r\n    {return}\r\n}\r\n\r\n{catch;\r\n    {=header.lootType;{replace;{find;{$analiserLines.0};/Loot Type: (Leader|Market)$/};Loot Type: ;}}\r\n    {if;{$header.lootType};;{throw;}}\r\n    {=avoidPrint;{shift;{$analiserLines}}}\r\n;\r\n    {responder.text;Error in line 3 - Loot type}\r\n    {return}\r\n}\r\n\r\n{catch;\r\n    {=header.loot;{find;{replace;{$analiserLines.0};,;};/(?<=Loot: )\\d+(?=)$/}}\r\n    {if;{$header.loot};;{throw;}}\r\n    {=avoidPrint;{shift;{$analiserLines}}}\r\n;\r\n    {responder.text;Error in line 4 - Loot}\r\n    {return}\r\n}\r\n\r\n{catch;\r\n    {=header.supplies;{find;{replace;{$analiserLines.0};,;};/(?<=Supplies: )\\d+(?=)$/}}\r\n    {if;{$header.supplies};;{throw;}}\r\n    {=avoidPrint;{shift;{$analiserLines}}}\r\n;\r\n    {responder.text;Error in line 5 - Supplies}\r\n    {return}\r\n}\r\n\r\n{catch;\r\n    {=header.balance;{find;{replace;{$analiserLines.0};,;};/(?<=Balance: )\\d+(?=)$/}}\r\n    {if;{$header.balance};;{throw;}}\r\n    {=avoidPrint;{shift;{$analiserLines}}}\r\n;\r\n    {responder.text;Error in line 6 - Balance}\r\n    {return}\r\n}\r\n\r\n{if;{math precision_fix=false;{length;{$analiserLines}}%6};!=;0;\r\n    {responder.text;Error in lines 7+ - some lines are missing or have been added}\r\n    {return}\r\n}\r\n\r\n{=playerCount;{math precision_fix=false;{length;{$analiserLines}}/6}}\r\n\r\n{=individualBalance;{math;round({$header.balance}/{$playerCount})}}\r\n{=playersData;{[]}}\r\n{=calculatedData.loot;0}\r\n{=calculatedData.supplies;0}\r\n{=calculatedData.balance;0}\r\n{=calculatedData.damage;0}\r\n{=calculatedData.healing;0}\r\n\r\n{for;{=i};{range;{$playerCount}};\r\n    {=playerData.name;{replace;{$analiserLines.0}; (Leader);}}\r\n    {=avoidPrint;{shift;{$analiserLines}}}\r\n\r\n    {=playerData.loot;{find;{replace;{$analiserLines.0};,;};/(?<=    Loot: )\\d+(?=)$/}}\r\n    {=avoidPrint;{shift;{$analiserLines}}}\r\n    {if;{$playerData.loot};;{responder.text;Error in line {math precision_fix=false;6+6*{$i}+2}}{return}}\r\n    {=calculatedData.loot;{math precision_fix=false;{$calculatedData.loot}+{$playerData.loot}}}\r\n\r\n    {=playerData.supplies;{find;{replace;{$analiserLines.0};,;};/(?<=    Supplies: )\\d+(?=)$/}}\r\n    {=avoidPrint;{shift;{$analiserLines}}}\r\n    {if;{$playerData.supplies};;{responder.text;Error in line {math precision_fix=false;6+6*{$i}+3}}{return}}\r\n    {=calculatedData.supplies;{math precision_fix=false;{$calculatedData.supplies}+{$playerData.supplies}}}\r\n\r\n    {=playerData.balance;{find;{replace;{$analiserLines.0};,;};/(?<=    Balance: )[-]?\\d+(?=)$/}}\r\n    {=avoidPrint;{shift;{$analiserLines}}}\r\n    {if;{$playerData.balance};;{responder.text;Error in line {math precision_fix=false;6+6*{$i}+4}}{return}}\r\n    {=calculatedData.balance;{math precision_fix=false;{$calculatedData.balance}+{$playerData.balance}}}\r\n\r\n    {=playerData.damage;{find;{replace;{$analiserLines.0};,;};/(?<=    Damage: )\\d+(?=)$/}}\r\n    {=avoidPrint;{shift;{$analiserLines}}}\r\n    {if;{$playerData.damage};;{responder.text;Error in line {math precision_fix=false;6+6*{$i}+5}}{return}}\r\n    {=calculatedData.damage;{math precision_fix=false;{$calculatedData.damage}+{$playerData.damage}}}\r\n\r\n    {=playerData.healing;{find;{replace;{$analiserLines.0};,;};/(?<=    Healing: )\\d+(?=)$/}}\r\n    {=avoidPrint;{shift;{$analiserLines}}}\r\n    {if;{$playerData.healing};;{responder.text;Error in line {math precision_fix=false;6+6*{$i}+6}}{return}}\r\n    {=calculatedData.healing;{math precision_fix=false;{$calculatedData.healing}+{$playerData.healing}}}\r\n\r\n    {=playerData.balanceNorm;{math precision_fix=false;{$playerData.balance}-{$individualBalance}}}\r\n    {=playerData.transfers;{[]}}\r\n\r\n    {push;{$playersData};{$playerData}}\r\n}\r\n\r\n{if;{$calculatedData.loot};!=;{$header.loot};\r\n    {responder.text;Error - sum of loot values does not match total loot.\\nHeader is {$header.loot}, while the sum is {$calculatedData.loot}}\r\n    {return}\r\n}\r\n{if;{$calculatedData.balance};!=;{$header.balance};\r\n    {responder.text;Error - sum of balance values does not match total balance.\\nHeader is {$header.balance}, while the sum is {$calculatedData.balance}}\r\n    {return}\r\n}\r\n{if;{$calculatedData.supplies};!=;{$header.supplies};\r\n    {responder.text;Error - sum of supplies values does not match total supplies.\\nHeader is {$header.supplies}, while the sum is {$calculatedData.supplies}}\r\n    {return}\r\n}\r\n\r\n{=calculatedPlayers;{[]}}\r\n{for;{=i};{range;{math precision_fix=false;{$playerCount}-1}};\r\n    {=playersData;{sort;{$playersData};balanceNorm}}\r\n    \r\n    {=wealthiest;{pop;{$playersData}}}\r\n    {=poorest;{shift;{$playersData}}}\r\n    {=poorestNegBal;{math precision_fix=false;abs({$poorest.balanceNorm})}}\r\n    \r\n    {if;{$poorestNegBal};>;{$wealthiest.balanceNorm};\r\n        {push;{$wealthiest.transfers};```transfer {$wealthiest.balanceNorm} to {$poorest.name}```}\r\n        {=poorest.balanceNorm;{math precision_fix=false;{$poorest.balanceNorm}+{$wealthiest.balanceNorm}}}\r\n        {=wealthiest.balanceNorm;0}\r\n        {push;{$playersData};{$poorest}}\r\n        {push;{$calculatedPlayers};{$wealthiest}}\r\n        {if;{$i};===;{math precision_fix=false;{$playerCount}-2};\r\n            {push;{$calculatedPlayers};{$poorest}}\r\n        }\r\n    ;\r\n        {push;{$wealthiest.transfers};```transfer {$poorestNegBal} to {$poorest.name}```}\r\n        {=wealthiest.balanceNorm;{math precision_fix=false;{$wealthiest.balanceNorm}+{$poorest.balanceNorm}}}\r\n        {=poorest.balanceNorm;0}\r\n        {push;{$playersData};{$wealthiest}}\r\n        {push;{$calculatedPlayers};{$poorest}}\r\n        {if;{$i};===;{math precision_fix=false;{$playerCount}-2};\r\n            {push;{$calculatedPlayers};{$wealthiest}}\r\n        }\r\n    }\r\n}\r\n\r\n{=topStats.loot;{[]}}\r\n{=topStats.supplies;{[]}}\r\n{=topStats.damage;{[]}}\r\n{=topStats.healing;{[]}}\r\n{=sortedByLoot;{sort;{$calculatedPlayers};loot}}\r\n{=sortedBySupplies;{sort;{$calculatedPlayers};supplies}}\r\n{=sortedByDamage;{sort;{$calculatedPlayers};damage}}\r\n{=sortedByHealing;{sort;{$calculatedPlayers};healing}}\r\n\r\n{for;{=i};{range;{$playerCount}};\r\n    {=player;{pop;{$sortedByLoot}}}\r\n    {push;{$topStats.loot};> {$player.name} **{math;round(1000*{$player.loot}/{$header.loot})/10}%**}\r\n\r\n    {=player;{shift;{$sortedBySupplies}}}\r\n    {push;{$topStats.supplies};> {$player.name} **{math;round(1000*{$player.supplies}/{$header.supplies})/10}%**}\r\n\r\n    {=player;{pop;{$sortedByDamage}}}\r\n    {push;{$topStats.damage};> {$player.name} **{math;round(1000*{$player.damage}/{$calculatedData.damage})/10}%**}\r\n\r\n    {=player;{pop;{$sortedByHealing}}}\r\n    {push;{$topStats.healing};> {$player.name} **{math;round(1000*{$player.healing}/{$calculatedData.healing})/10}%**}\r\n}\r\n\r\n{responder.embed \r\n    title=\"Hunt stats\"\r\n    description=\"Started: **{$header.fromDate}**, at **{$header.fromHour}**\\nDuration: **{$header.duration}h**\\nBalance: **{formatNumber;{$header.balance}}**\\nIndividual balance: **{formatNumber;{$individualBalance}}**\"\r\n    color=\"#8381c3\"\r\n}\r\n{responder.embedField name=\"Damage:\" value={join;{$topStats.damage};\\n} inline=true}\r\n{responder.embedField name=\"Healing:\" value={join;{$topStats.healing};\\n} inline=true}\r\n{responder.embedField name=\"‎\" value=\"‎\" inline=false}\r\n{responder.embedField name=\"Loot:\" value={join;{$topStats.loot};\\n} inline=true}\r\n{responder.embedField name=\"Supplies:\" value={join;{$topStats.supplies};\\n} inline=true}\r\n\r\n{responder.embed title=\"Transfers\" color=\"#8381c3\"}\r\n{for;{=player};{$calculatedPlayers};\r\n    {if;{length;{$player.transfers}};>;0;\r\n        {responder.embedField\r\n            name=\"{$player.name}\"\r\n            value=\"{join;{$player.transfers};\\n}\"\r\n        }\r\n    }\r\n}\r\n{=msgId;{responder.send return_id=true}}\r\n{message.addReaction;✅;{$msgId}}",
